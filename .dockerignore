# Installed fresh inside the image
/vendor
/node_modules

# Secrets and local state: configuration comes from environment variables
.env
.env.*
!.env.example
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*.php
/public/uploads/submissions/*
/public/uploads/branding

# Not needed at runtime
.git
.github
.idea
.vscode
/tests
/docs
.phpunit.result.cache
*.log
Dockerfile
.dockerignore
